<Window x:Class="eindopdracht_csharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:eindopdracht_csharp"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"></RowDefinition>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="0.8*"></RowDefinition>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Background="Beige">
                <Button Click="Button_Click" Margin="4">Toevoegen</Button>

                <TextBlock Text="naam " Margin="4,10" FontSize="12"/>
                <TextBox Name="naam" Margin="4" Height="20"/>

                <TextBlock Text="Ben je vrolijk" Margin="4,10" FontSize="12"/>
                <StackPanel Orientation="Horizontal" >
                    <RadioButton Content="ja" Name="ja" Margin="5" FontSize="12"/>
                    <RadioButton Content="nee" Name="nee" Margin="5" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            
     

            <StackPanel Grid.Row="1" Orientation="Vertical" RenderTransformOrigin="0.834,0.317" Background="Beige">
                <TextBlock Text="Gepersonaliseerde vis: " Margin="4" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="kleur: " Margin="4" FontSize="12"/>
                <xctk:ColorPicker Name="kleurkiezer" Margin="4" SelectedColor="OrangeRed"/>

                <TextBlock Text="grootte: " Margin="4" FontSize="12"/>
                <TextBox Name="groot" Margin="4" Height="20"/>

                <TextBlock Text="breedte" Margin="4,10" FontSize="12"/>
                <TextBox Margin="4" Height="20" Name="breedte" />

                

                <ListBox Name="lijst" Width="auto" Height="80" Margin="10"/>
            </StackPanel>

            <Grid Grid.Row="3" Background="Beige">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                    
                    
                    <Button Click="Button_Click_1" Margin="4" Height="30" >Eigen Button
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">

                                <GradientStop Color="Aquamarine" Offset="0"/>
                                <GradientStop Color="Purple" Offset="1"/>
           
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    
                    
                    <Button Margin="4" Height="30" Width="75" Click="Button_Click_2" Background="Green" Foreground="white" >plant</Button>
                    
                    
                    <Button Height="30" Width="75" Click="Button_Click_3" >Reset</Button>
                    
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                    <TextBlock Text="verwijderen:"  Width="100" Height="30"  VerticalAlignment="Top" />
                    <TextBox Background="LightGray"  Width="100" Height="30" Name="kleurwisser"/>
                    <Button Content="Verwijderen" Width="100" Height="30" Margin="5,10" Background="Red" Foreground="White" Click="Button_Click_4"/>
                </StackPanel>
               



            </Grid>
            
        </Grid>

        <Canvas Grid.Column="1" x:Name="aquarium" Background="Aqua">

        </Canvas>

       




    </Grid>
</Window>
