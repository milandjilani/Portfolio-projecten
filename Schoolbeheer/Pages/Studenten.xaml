<Page x:Class="schoolbeheer.Pages.Studenten"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:schoolbeheer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="500"
      Title="Studenten" Background="#F1F5F9">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Student toevoegen"
               FontSize="26"
               FontWeight="Bold"
               Margin="10,0,0,0"
               Grid.Row="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"/>

        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="25">

            <Grid HorizontalAlignment="Stretch">
                <StackPanel MaxWidth="650"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,20">

                    <TextBlock Text="Voornaam"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="txtVoornaam"
                         Height="38"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                    <TextBlock Text="Achternaam"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="txtAchternaam"
                         Height="38"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                    <TextBlock Text="Geboortedatum"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <DatePicker x:Name="dpGeboortedatum"
                            Height="38"
                            FontSize="16"
                            SelectedDateFormat="Short"
                            FirstDayOfWeek="Monday"
                            Margin="0,0,0,12"/>

                    <TextBlock Text="E-mailadres"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="txtEmail"
                         Height="38"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,15"/>

                    <Button x:Name="btnVoegStudentToe"
                        Content="Student toevoegen"
                        Height="40"
                        FontSize="16"
                        Margin="0,0,0,25"
                        BorderBrush="#16A34A"
                        BorderThickness="2"
                        Click="btnVoegStudentToe_Click"/>

                    <Separator Margin="0,0,0,20"/>

                    <TextBlock Text="Student verwijderen"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                    <TextBlock Text="Selecteer een student om te verwijderen."
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                    <ComboBox x:Name="cmbStudenten"
                          Height="38"
                          FontSize="16"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,15"
                          DisplayMemberPath="VolledigeNaam"
                          SelectedValuePath="StudentID"/>

                    <Button x:Name="btnVerwijderStudent"
                        Content="Student verwijderen"
                        Height="40"
                        FontSize="16"
                        BorderBrush="#DC2626"
                        BorderThickness="2"
                        Click="btnVerwijderStudent_Click"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</Page>
