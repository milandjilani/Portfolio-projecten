<Page x:Class="schoolbeheer.Pages.Updatedocent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:schoolbeheer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Updatedocent" Background="White">




    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Update Docenten"
                   FontWeight="DemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   FontSize="26"/>

            <Button Grid.Column="1"
                Content="Update"
                Width="100"
                Height="40"
                Click="Update_Click"
                VerticalAlignment="Center"
                FontSize="16"/>
        </Grid>

        <DataGrid x:Name="dgDocent"
              Grid.Row="1"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              FontSize="16"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              HorizontalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn Header="DocentID"
                                Binding="{Binding DocentID}"
                                Width="100"
                                IsReadOnly="True"/>

                <DataGridTextColumn Header="Voornaam"
                                Binding="{Binding Voornaam}"
                                Width="2*"
                                MinWidth="100"/>

                <DataGridTextColumn Header="Achternaam"
                                Binding="{Binding Achternaam}"
                                Width="2*"
                                MinWidth="100"/>

                <DataGridTextColumn Header="Email"
                                Binding="{Binding Email}"
                                Width="3*"
                                MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>



</Page>
