<Page x:Class="schoolbeheer.Pages.Vakken"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:schoolbeheer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="500"
      Title="Vakken" Background="#F1F5F9">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Verplichte vakken toevoegen"
               FontSize="26"
               FontWeight="Bold"
               Margin="10,0,0,0"
               Grid.Row="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"/>

        <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="25">

            <Grid HorizontalAlignment="Stretch">
                <StackPanel MaxWidth="650"
                        HorizontalAlignment="Stretch"
                        Margin="0,10,0,20">

                    <TextBlock Text="Vaknaam"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <ComboBox x:Name="cmbVaknaam"
                          Height="38"
                          FontSize="16"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,12"/>

                    <TextBlock Text="Beschrijving"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <TextBox x:Name="txtBeschrijving"
                         Height="80"
                         FontSize="18"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Padding="5"
                         Margin="0,0,0,12"/>

                    <TextBlock Text="Aantal studiepunten"
                           FontSize="16"
                           Margin="0,0,0,5"/>

                    <ComboBox x:Name="cmbStudiepunten"
                          Height="38"
                          FontSize="16"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,15"/>

                    <Button x:Name="btnVoegVakToe"
                        Content="Vak toevoegen"
                        Height="40"
                        FontSize="16"
                        Margin="0,0,0,25"
                        BorderBrush="#16A34A"
                        BorderThickness="2"
                        Click="btnVoegVakToe_Click"/>

                    <Separator Margin="0,0,0,20"/>

                    <TextBlock Text="Vak verwijderen"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                    <TextBlock Text="Selecteer een vak om te verwijderen."
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                    <ComboBox x:Name="cmbVakken"
                          Height="38"
                          FontSize="16"
                          VerticalContentAlignment="Center"
                          Margin="0,0,0,15"
                          DisplayMemberPath="Vak"
                          SelectedValuePath="VakID"/>

                    <Button x:Name="btnVerwijderVak"
                        Content="Vak verwijderen"
                        Height="40"
                        FontSize="16"
                        BorderBrush="#DC2626"
                        BorderThickness="2"
                        Click="btnVerwijderVak_Click"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>

</Page>
