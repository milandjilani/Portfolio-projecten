<Page x:Class="schoolbeheer.Pages.Koppelpagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:schoolbeheer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Koppelpagina" Background="White">



    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titel -->
            <RowDefinition Height="Auto"/>
            <!-- Formulier -->
            <RowDefinition Height="Auto"/>
            <!-- Overzicht label -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- TITEL -->
        <TextBlock Text="Docent aan klas koppelen"
               FontSize="28"
               FontWeight="DemiBold"
               Margin="0 0 0 20"/>

        <!-- FORMULIER -->
        <StackPanel Grid.Row="1"
                Orientation="Vertical"
                HorizontalAlignment="Stretch">

            <TextBlock Text="Docent"
                   FontSize="16"
                   Margin="0 0 0 5"/>

            <ComboBox x:Name="cmbDocent"
                  Height="38"
                  FontSize="16"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="fullname"
                  SelectedValuePath="DocentID"/>

            <TextBlock Text="Klas"
                   FontSize="16"
                   Margin="0 15 0 5"/>

            <ComboBox x:Name="cmbKlas"
                  Height="38"
                  FontSize="16"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="fullname"
                  SelectedValuePath="KlasID"/>

            <Button Content="Opslaan"
                Padding="10 5"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0 15 0 0"
                Click="Button_Click"/>
        </StackPanel>

        <!-- OVERZICHT LABEL -->
        <TextBlock Text="Overzicht:"
               FontSize="18"
               FontWeight="DemiBold"
               Margin="0 20 0 10"
               Grid.Row="2"/>

        <!-- DATAGRID -->
        <DataGrid x:Name="dgKoppeling"
              Grid.Row="3"
              AutoGenerateColumns="False"
              FontSize="16"
              HeadersVisibility="Column"
              IsReadOnly="True"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              BorderBrush="SteelBlue"
              BorderThickness="2"
              ColumnWidth="*">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Docent"
                                Binding="{Binding Docent}"
                                Width="2*"/>

                <DataGridTextColumn Header="Klas"
                                Binding="{Binding Klas}"
                                Width="1*"/>

                <DataGridTextColumn Header="Opleiding"
                                Binding="{Binding Opleiding}"
                                Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>




</Page>
