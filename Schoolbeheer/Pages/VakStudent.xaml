<Page x:Class="schoolbeheer.Pages.VakStudent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:schoolbeheer.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="400"
      Title="VakStudent" Background="White">


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="187"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Student aan Vak koppelen"
               FontSize="25"
               VerticalAlignment="Center"
               FontWeight="DemiBold"
               Grid.Row="0"/>

        <StackPanel Grid.Row="1"
                HorizontalAlignment="Stretch">

            <TextBlock Text="Student"
                   FontSize="16"
                   Margin="0,0,0,5"/>

            <ComboBox x:Name="cmbStudent"
                  Height="38"
                  FontSize="16"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="Volledig"
                  SelectedValuePath="StudentID"/>

            <TextBlock Text="Vak"
                   FontSize="16"
                   Margin="0,15,0,5"/>

            <ComboBox x:Name="cmbVak"
                  Height="38"
                  FontSize="16"
                  HorizontalAlignment="Stretch"
                  VerticalContentAlignment="Center"
                  DisplayMemberPath="Volledig"
                  SelectedValuePath="VakID"/>

            <Button Content="Opslaan"
                Padding="5"
                Width="60"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="Button_Click"/>
        </StackPanel>

        <TextBlock Text="Overzicht:"
               FontWeight="DemiBold"
               FontSize="15"
               Grid.Row="2"/>

        <DataGrid x:Name="dgStudentVak"
              Grid.Row="3"
              AutoGenerateColumns="False"
              FontSize="16"
              IsReadOnly="True"
              BorderThickness="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              MinHeight="200"
              MinWidth="400">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Student"
                                Binding="{Binding Student}"
                                Width="2*"
                                MinWidth="150"/>

                <DataGridTextColumn Header="Vak"
                                Binding="{Binding Vak}"
                                Width="2*"
                                MinWidth="100"/>

                <DataGridTextColumn Header="Studiepunten"
                                Binding="{Binding Studiepunten}"
                                Width="*"
                                MinWidth="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>


</Page>
