<Page x:Class="ideavoorstel_auto_lease.Paginas.Autolease"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ideavoorstel_auto_lease.Paginas"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autolease" Background="#F2F4F7">

    <ScrollViewer>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <!-- BOVENSTE DEEL -->
            <StackPanel Grid.Row="0" Margin="0 0 0 10">

                <TextBlock Text="Leasecontracten"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0 0 0 10"/>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="In dit venster kunt u uw start en einddatum aanpassen"
                    FontSize="14"
                    Margin="0 0 0 15" HorizontalAlignment="Left"/>

                    <Button  Width="100" Height="30" FontSize="15" HorizontalAlignment="Left"  Background="LightSlateGray" Click="Button_Click">refresh</Button>

                </StackPanel>

                <DataGrid x:Name="dgLeaseOverzicht"
                      AutoGenerateColumns="False"
                      Height="220"
                      Margin="0 0 0 10"
                      MouseDoubleClick="dgLeaseOverzicht_MouseDoubleClick">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Auto"
                                        Binding="{Binding AutoNaam}"
                                        Width="*" />

                        <DataGridTextColumn Header="Startdatum"
                                        Binding="{Binding startdatum, StringFormat=\{0:dd-MM-yyyy\}}"
                                        Width="150" />

                        <DataGridTextColumn Header="Einddatum"
                                        Binding="{Binding einddatum, StringFormat=\{0:dd-MM-yyyy\}}"
                                        Width="150" />
                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1"
                      Height="2"
                      Background="Black"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center" />

          
            <StackPanel Grid.Row="2" Margin="0 10 0 0">

                <TextBlock Text="In deze pagina heeft u ook de mogelijkheid om het contract op te zeggen. Nadat onze administratie de opzegging heeft goedgekeurd, zal deze uit ons systeem verwijderd worden."
                       TextWrapping="Wrap"
                       Width="500"
                       Margin="0 0 0 15"
                       FontSize="16" />

                <ComboBox x:Name="verwijderbox"
                      Width="450"
                      Height="30"
                      BorderBrush="CadetBlue"
                      BorderThickness="2"
                      Margin="0 0 0 10"
                      SelectedValuePath="autoID"  />

                <Button Content="Contract verwijderen"
                    Background="LightSlateGray"
                    Foreground="White"
                    Width="180"
                    Height="35"
                    HorizontalAlignment="Left"
                    Click="verwijdercc" />

            </StackPanel>

        </Grid>
    </ScrollViewer>

</Page>
