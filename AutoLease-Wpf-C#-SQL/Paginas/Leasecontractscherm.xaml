<Page x:Class="ideavoorstel_auto_lease.Paginas.Leasecontractscherm"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ideavoorstel_auto_lease.Paginas"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="Leasecontractscherm" Background="#F2F4F7">

    <Grid>
        <StackPanel Margin="20" Orientation="Vertical">

            <!-- Titel -->
            <TextBlock Text="Leasecontract toevoegen"
               FontSize="26"
               FontWeight="Bold"
               Margin="0 0 0 20"/>

            <!-- AutoID -->
            <TextBlock Text="Auto" FontWeight="Bold" FontSize="16"/>
            <ComboBox x:Name="cbAutoID"
          Height="30"
          Margin="0 5 0 15"
          DisplayMemberPath="VolledigeNaam"
          SelectedValuePath="AutoID"
          ItemsSource="{Binding Autos}" />
            
            <TextBlock Text="Klant" FontWeight="Bold" FontSize="16"/>
            <ComboBox x:Name="cbKlantID"
          Height="30"
          Margin="0 5 0 15"
          DisplayMemberPath="VolledigeKlant"
          SelectedValuePath="KlantID"
          ItemsSource="{Binding Klanten}" />
            <!-- Startdatum -->
            <TextBlock Text="Startdatum" FontWeight="Bold" FontSize="16"/>
            <DatePicker x:Name="tbStartdatum"
             Height="30"
             Margin="0 5 0 15"/>

            <!-- Einddatum -->
            <TextBlock Text="Einddatum" FontWeight="Bold" FontSize="16"/>
            <DatePicker x:Name="tbEinddatum"
             Height="30"
             Margin="0 5 0 15"/>

            <!-- Maandbedrag -->
            <TextBlock Text="Maandbedrag" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="tbMaandbedrag"
             Height="30"
             Margin="0 5 0 25"/>

    
            <Button Content="Opslaan"
                Width="140"
                Height="35"
                Background="#1E2A38"
                Foreground="White"
                FontSize="16"
       
                HorizontalAlignment="Left" Click="Button_Click"/>

            <Button Content="loading" Width="120" Height="35" FontSize="16" HorizontalAlignment="Right" Background="#1E2A38" Foreground="White" Name="loading" Click="Button_Click_1"/>


        </StackPanel>


    </Grid>
</Page>
