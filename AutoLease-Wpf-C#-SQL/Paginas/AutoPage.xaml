<Page x:Class="ideavoorstel_auto_lease.Paginas.AutoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ideavoorstel_auto_lease.Paginas"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AutoPage">

    <Grid Background="#F2F4F7">
        <ScrollViewer >

            <StackPanel Margin="20" Orientation="Vertical">

                <!-- Titel -->
                <TextBlock Text="Auto toevoegen"
               FontSize="26"
               FontWeight="Bold"
               Margin="0 0 0 20"/>

                <!-- Merk -->
                <TextBlock Text="Merk" FontWeight="Bold" FontSize="16"/>
                <ComboBox x:Name="cbMerk" Height="30" Margin="0 5 0 15"/>

                <!-- Model -->
                <TextBlock Text="Model" FontWeight="Bold" FontSize="16"/>
                <TextBox x:Name="tbModel" Height="30" Margin="0 5 0 15"/>

                <!-- Bouwjaar -->
                <TextBlock Text="Bouwjaar" FontWeight="Bold" FontSize="16"/>
                <TextBox x:Name="tbBouwjaar" Height="30" Margin="0 5 0 15"/>

                <!-- Kilometerstand -->
                <TextBlock Text="Kilometerstand" FontWeight="Bold" FontSize="16"/>
                <TextBox x:Name="tbKmStand" Height="30" Margin="0 5 0 15"/>

                <!-- Kenteken -->
                <TextBlock Text="Kenteken" FontWeight="Bold" FontSize="16"/>
                <TextBox x:Name="tbKenteken" Height="30" Margin="0 5 0 15"/>

                <!-- Status -->
                <TextBlock Text="Status" FontWeight="Bold" FontSize="16"/>
                <ComboBox x:Name="tbStatus" Height="30" Margin="0 5 0 25">
                   
                </ComboBox>


                <!-- Opslaan knop -->
                <Button Content="Opslaan"
                        Width="140"
                        Height="35"
                        Background="#1E2A38"
                        Foreground="White"
                        FontSize="16"
                      
                        HorizontalAlignment="Left" Click="Button_Click"
            />

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
