<Page x:Class="ideavoorstel_auto_lease.Paginas.KlantenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ideavoorstel_auto_lease.Paginas"
      mc:Ignorable="d" 
      d:DesignHeight="350" d:DesignWidth="800"
      Title="KlantenPage" Background="#F2F4F7">

    <Grid>
        <StackPanel Margin="20" Orientation="Vertical">

            <!-- Titel -->
            <TextBlock Text="Klant toevoegen"
               FontSize="26"
               FontWeight="Bold"
               Margin="0 0 0 20"/>

            <!-- Naam -->
            <TextBlock Text="Naam" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="tbNaam" Height="30" Margin="0 5 0 15"/>

            <!-- Telefoonnummer -->
            <TextBlock Text="Telefoonnummer" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="tbTelefoon" Height="30" Margin="0 5 0 15"/>

            <!-- E-mail -->
            <TextBlock Text="E-mail" FontWeight="Bold" FontSize="16"/>
            <TextBox x:Name="tbEmail" Height="30" Margin="0 5 0 25"/>

            <!-- Opslaan knop -->
            <Button Content="Opslaan"
                Width="140"
                Height="35"
                Background="#1E2A38"
                Foreground="White"
                FontSize="16"
                      
                HorizontalAlignment="Left" Click="Button_Click"
                    />
        </StackPanel>



    </Grid>
</Page>
